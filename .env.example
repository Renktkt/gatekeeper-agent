# Copy to .env or export in your supervisor unit. NEVER commit real values.

# Platform HMAC secret — from the agent dashboard, "Rotate Secret" (required)
AGENT_GAMES_SECRET=

# Kurier API key — free from kurier.xyz (required for scored competition)
KURIER_API_KEY=

# Listen address
PORT=8080
HOST=0.0.0.0

# Optional tuning (defaults shown in README)
# KURIER_BASE_URL=https://api.kurier.xyz/api/v1
# KURIER_VK_HASH=
# RESPONSE_BUDGET_MS=50000
# SEEN_STORE_PATH=/var/lib/gatekeeper/seen.json
